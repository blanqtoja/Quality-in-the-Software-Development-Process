{
  "name": "qitsdp-erp-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Wspólny projekt testów API i UI Manufacturing ERP",
  "scripts": {
    "test:ui": "playwright test --config=playwright.config.cjs",
    "test:ui:lukasz": "npm run test:ui -- --grep @lukasz",
    "test:ui:list": "npm run test:ui -- --list",
    "report:ui": "playwright show-report reports/ui/html"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
